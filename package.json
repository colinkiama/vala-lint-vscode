{
  "name": "linter-vala",
  "displayName": "Vala-Lint",
  "description": "vscode-linter extension that add Vala linting support via vala-lint",
  "icon": "img/vala-lint.png",
  "version": "2.0.0",
  "publisher": "ColinKiama",
  "engines": {
    "vscode": "^1.57.0"
  },
  "repository": "https://www.github.com/colinkiama/vala-lint-vscode",
  "categories": [
    "Linters"
  ],
  "keywords": [
    "vala",
    "linter",
    "vala-lint",
    "lint",
    "linting"
  ],
  "activationEvents": [
    "onLanguage:vala"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vala-lint.fixAll",
        "title": "Vala-Lint: Fix All Auto-Fixable Problems"
      }
    ],
    "configuration": {
      "title": "Vala-Lint",
      "properties": {
        "vala-lint.enable": {
          "default": true,
          "description": "Enable linting Vala files with vala-lint.",
          "type": "boolean"
        },
        "vala-lint.path": {
          "default": "io.elementary.vala-lint",
          "description": "Path to the vala-lint binary.",
          "type": "string"
        },
        "vala-lint.configFile": {
          "default": null,
          "description": "Path to a vala-lint config file. When unset, the nearest vala-lint.conf or .vala-lint.conf is searched for, starting from the linted file's directory up to the workspace root.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
